PORT=3000
NODE_ENV=development

FINMIND_API_URL=https://api.finmindtrade.com/api/v4/data
# FINMIND_TOKEN=your_token_here

FALLBACK_PRICE_0050=160.0
FALLBACK_PRICE_00631L=210.0

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Rebalance-Cluster
MONGODB_DB_NAME=rebalancealert
# MONGODB_PROFILE_ID=default

# LINE Messaging API（每日推播與訊息查詢槓桿）
# 詳細設定步驟見 Doc/setup-line-notify.md
# LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token
# LINE_CHANNEL_SECRET=your_channel_secret
# LINE_NOTIFY_USER_IDS=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LINE_NOTIFY_CRON=0 9 * * *
# LINE_NOTIFY_TIMEZONE=Asia/Taipei
